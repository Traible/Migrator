# Third-party programs are not part of the repository.
# "Get Tools.bat" installs them or puts portable copies here.
Tools/

# Generated data
Backups/*
!Backups/.gitkeep
Logs/*
!Logs/.gitkeep
dist/

# Per-user settings (language choice etc.)
src/config/user.json

# Archives and reports produced by the tool
*.7z
*.rar
*.manifest.json
*.summary.txt
*.errors.log
*.log

# Never commit license keys of third-party software
rarreg.key
*.key

# Local and editor noise
Thumbs.db
desktop.ini
.vscode/
.idea/
